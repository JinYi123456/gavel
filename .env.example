# GAVEL environment — copy to .env.local and fill in. Never commit real keys.

# --- Agent brains (server-side only) ---
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=unsloth/Llama-3.3-70B-Instruct
FEATHERLESS_MODEL_FALLBACK=Qwen/Qwen3-235B-A22B

# --- Voice evidence transcription (server-side only) ---
ASSEMBLYAI_API_KEY=

# --- Runtime behavior ---
# GAVEL_FORCE_SCRIPTED=1 forces the deterministic transcript mode (no LLM calls).
GAVEL_FORCE_SCRIPTED=
# GAVEL_MAX_INPUT_CHARS caps intake length (default 6000).
GAVEL_MAX_INPUT_CHARS=
