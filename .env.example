# GAVEL environment — copy to .env.local and fill in. Never commit real keys.

# --- Agent brains (server-side only) ---
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=unsloth/Llama-3.3-70B-Instruct
# Only set a fallback that has been measured with `npm run eval:agents`:
# a model that fails the gate adds latency, not resilience. Leave blank to use
# the primary model at both temperatures.
FEATHERLESS_MODEL_FALLBACK=

# --- Voice evidence transcription (server-side only) ---
ASSEMBLYAI_API_KEY=

# --- Runtime behavior ---
# GAVEL_FORCE_SCRIPTED=1 forces the deterministic transcript mode (no LLM calls).
GAVEL_FORCE_SCRIPTED=
# GAVEL_MAX_INPUT_CHARS caps intake length (default 6000).
GAVEL_MAX_INPUT_CHARS=
# The court speaks from the scripted bench if no live draft passes the gate
# within this window (ms, default 5000).
GAVEL_LIVE_GRACE_MS=
# Hard budget for the whole attempt chain (ms, default 15000).
GAVEL_TRIAL_BUDGET_MS=
# Requests per browser session per five minutes (default 60).
GAVEL_RATE_MAX=
